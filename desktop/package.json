{
  "name": "sala-mimi-explica",
  "version": "1.0.0",
  "description": "Sala de aula ao vivo do Mimi Explica",
  "author": "Mimi Explica",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.com.mimiexplica.sala",
    "productName": "Sala Mimi Explica",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.js",
      "icon.png",
      "node_modules/peerjs/dist/peerjs.min.js",
      "node_modules/qrcode-generator/qrcode.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "SalaMimi-Setup.exe",
      "shortcutName": "Sala Mimi Explica"
    },
    "protocols": [
      {
        "name": "Sala Mimi Explica",
        "schemes": [
          "mimisala"
        ]
      }
    ]
  }
}
